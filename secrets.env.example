# Copier en secrets.env (ignoré par Git) puis renseigner les valeurs.
DUCKDNS_DOMAIN=nexshop-mab          # sous-domaine, sans « .duckdns.org »
DUCKDNS_TOKEN=                      # token du compte DuckDNS
TEST_USERNAME=mab                   # utilisateur Keycloak de test (créé à l'import du realm)
TEST_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
